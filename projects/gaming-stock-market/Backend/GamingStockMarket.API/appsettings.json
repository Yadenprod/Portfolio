{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
        "DefaultConnection": "Host=host.docker.internal;Port=5432;Database=gamingstockmarketdb;Username=admin;Password=millioner2023"
  },
  "JwtSettings": {
    "SecretKey": "your-jwt-super-secret-key-that-is-at-least-32-characters-long",
    "Issuer": "GamingStockMarket",
    "Audience": "GamingStockMarket",
    "ExpirationHours": 24
  },
  "StripeSettings": {
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET"
  },
  "EmailServiceSettings": {
    "SendGridApiKey": "SG.YOUR_SENDGRID_API_KEY"
  },
  "TradingSettings": {
    "CommissionRate": 0.015,
    "MinOrderAmount": 1.0,
    "MaxOrderAmount": 10000.0
  },
  "PriceUpdateSettings": {
    "UpdateIntervalMinutes": 5,
    "PriceChangeThreshold": 0.01
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "GamingStockMarket.API"
    }
  }
}
