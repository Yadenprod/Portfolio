@echo off
echo 🎵 Настройка аудио для CS2 Sound Assistant
echo.
echo Этот скрипт поможет настроить аудио устройство для захвата системного звука
echo.

echo 📋 Инструкция по настройке:
echo.
echo 1. Нажмите Win + R
echo 2. Введите: mmsys.cpl
echo 3. Нажмите Enter
echo 4. Перейдите на вкладку "Запись"
echo 5. Найдите "Стерео микшер" или "Stereo Mix"
echo 6. Если его нет, щелкните правой кнопкой мыши в пустом месте
echo 7. Выберите "Показать отключенные устройства"
echo 8. Включите "Стерео микшер"
echo 9. Установите его как устройство по умолчанию
echo.

echo 🔧 Открываю настройки звука...
start mmsys.cpl

echo.
echo После настройки аудио устройства:
echo 1. Запустите CS2
echo 2. Убедитесь, что звук работает
echo 3. Запустите систему: run_system.bat
echo.

pause
